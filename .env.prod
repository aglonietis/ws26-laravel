# Deployed configuration — template.
#
# The entrypoint copies .env.prod over .env on every container start, so this
# file is what the deployed app actually runs against. It is written per
# competitor by Mission Control and is NOT committed: .env.prod is gitignored
# precisely because it carries real credentials.
#
# Copy this file to .env.prod and fill in the values.

APP_NAME=Laravel
APP_ENV=production
# Generate with: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
# The hostname the ingress serves this competitor on
APP_URL=https://example.ws2026.skill17.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# This competitor's own MySQL database.
# Leave MYSQL_ATTR_SSL_CA unset unless the server genuinely requires TLS.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
